{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cache Out",
  "mainBinaryName": "cache-out",
  "version": "0.1.0",
  "identifier": "com.stillmvd.cacheout",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cache Out",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/Cache Out/favicons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "stillmvd",
    "shortDescription": "Выборочная чистка данных браузеров",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis"]
  }
}
