{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cache Out",
  "mainBinaryName": "cache-out",
  "version": "0.1.4",
  "identifier": "com.stillmvd.cacheout",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cache Out",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Cache Out/favicons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "stillmvd",
    "shortDescription": "Выборочная чистка данных браузеров",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RUFCOEQ5NjczOTlCMTEKUldRUm16bG4yYmpxSjhGUkZ4Ri9hTEdPS0dMMTE3bE5vdElQMGxHeGJvb0Fta29XMHZtMEZKOFAK",
      "endpoints": [
        "https://github.com/stillmvd/cache-out/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
